{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edgeops-development",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "vars": {
    "MODE": "development",
    "AI_MODE": "fixture",
    "DAILY_AI_LIMIT": "10",
    // "on" streams remote assistant answers sentence by sentence (validated at the end).
    // Off until verified against live Workers AI streaming.
    "AI_STREAMING": "off",
    // External notification webhooks are a secret, not a var:
    //   wrangler secret put NOTIFICATION_WEBHOOKS  ->  [{"scope":"app/env","url":"https://...","format":"slack"}]
    "ACCESS_SUBJECTS": "",
    // Optional per-subject environment grants, e.g. {"<sub>":["trustplate/production"]}.
    // Empty means every allowed subject may use every environment.
    "SCOPE_GRANTS": "",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "PROBE_ALLOWLIST": "[{\"scope\": \"trustplate/production\", \"url\": \"https://api.trustplate.in/health\"}]",
    "PROVIDER_RESOURCES": "[]",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edgeops-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ASSISTANT",
        "class_name": "OpsAgent",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OpsAgent"],
    },
  ],
  "workflows": [
    {
      "binding": "INVESTIGATION",
      "name": "edgeops-development-investigation",
      "class_name": "InvestigationWorkflow",
    },
  ],
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
}
