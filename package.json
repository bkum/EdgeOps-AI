{
  "name": "edgeops-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.5 <23"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "npm run build:web && wrangler dev --ip 127.0.0.1",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "npm run build && node scripts/smoke.mjs",
    "db:migrate": "wrangler d1 migrations apply edgeops-local --local",
    "check": "npm run typecheck && npm test && npm run build:web",
    "build": "npm run build:web && wrangler deploy --dry-run --outdir dist/worker",
    "verify:ai": "npm run build && node scripts/verify-ai.mjs",
    "test:pilot": "npm run build && EDGEOPS_LIVE_PILOT=1 node scripts/smoke.mjs",
    "verify:clean": "node scripts/verify-clean.mjs",
    "verify:restore": "node scripts/verify-restore.mjs",
    "test:demo": "npm run build && EDGEOPS_RECORD_DEMO=1 node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "agents": "0.34.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "4.13.21",
    "jose": "6.2.18",
    "lucide-react": "1.79.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261124.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsonc-parser": "3.3.1",
    "miniflare": "5.20261123.0-beta",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.167.0"
  }
}
